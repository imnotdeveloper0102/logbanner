# Copy to .env and fill in real values. Never commit .env.
# Postgres
POSTGRES_USER=logbanner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logbanner
DATABASE_URL=postgres://logbanner:change-me@localhost:5432/logbanner

# Redis
REDIS_URL=redis://localhost:6379

# Gateway
PORT=3001
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
CORS_ORIGIN=http://localhost:5173
# Seed admin created on gateway start when both are set.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-me-admin-password

# Service-to-service shared secret (gateway <-> admin-service <-> agent)
SERVICE_TOKEN=change-me-service-token

# Admin service
ADMIN_SERVICE_PORT=8081
# Base URL the gateway proxies report and list import/export calls
# to (stage 7).
ADMIN_SERVICE_URL=http://localhost:8081

# Email alerts (stage 7). With SMTP_HOST unset the admin service
# sends nothing and logs a warning instead; set these to enable
# critical-ban and attack-wave alerts. ALERT_TO is the admin
# mailbox that receives them. SMTP_SECURE is empty, tls, or ssl.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=logbanner@example.local
SMTP_SECURE=
ALERT_TO=
# Attack-wave alert: at least ALERT_WAVE_THRESHOLD detections in
# ALERT_WAVE_WINDOW_MINUTES minutes, at most one mail per
# ALERT_WAVE_THROTTLE_MINUTES minutes.
ALERT_WAVE_THRESHOLD=50
ALERT_WAVE_WINDOW_MINUTES=10
ALERT_WAVE_THROTTLE_MINUTES=60

# Agent
AGENT_DRY_RUN=true
AGENT_CONFIG_PATH=/etc/logbanner/agent.yaml
# Auto-ban guards (stage 8). Max active bans at once (manual admin
# bans are not capped); the circuit breaker trips after more than
# AGENT_CB_MAX_BANS auto-bans in AGENT_CB_WINDOW_SECONDS seconds
# and re-arms AGENT_CB_COOLDOWN_SECONDS seconds after tripping.
AGENT_MAX_ACTIVE_BANS=1000
AGENT_CB_MAX_BANS=20
AGENT_CB_WINDOW_SECONDS=600
AGENT_CB_COOLDOWN_SECONDS=600
# Gateway: the agent's state dir (it writes sources-status.json
# there every 30s; the gateway reads it for the log-sources page),
# and the path of a GeoLite2 .mmdb file for GeoIP (see README
# stage 6 for how to obtain one; unset means lookups return
# "unknown").
AGENT_STATE_DIR=/var/lib/logbanner
GEOIP_DB_PATH=/etc/logbanner/GeoLite2-City.mmdb
